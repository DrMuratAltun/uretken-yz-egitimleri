---
import Layout from '../layouts/Layout.astro';
import { weeks } from '../data/curriculum';

const base = import.meta.env.BASE_URL;

const sections = [
  { label: 'VERİ BİLİMİ TEMELLERİ',      color: 'accent',    weeks: weeks.filter(w => w.id <= 4),            hours: 24 },
  { label: 'MAKİNE ÖĞRENMESİ UZMANLIĞI', color: 'secondary', weeks: weeks.filter(w => w.id >= 5 && w.id <= 9), hours: 30 },
  { label: 'YAPAY ZEKA MÜHENDİSLİĞİ',    color: 'primary',   weeks: weeks.filter(w => w.id >= 10),            hours: 36 },
];

const journeyBadge: Record<string, string> = {
  accent:    'bg-accent text-white',
  secondary: 'bg-secondary text-white',
  primary:   'bg-primary text-white',
};
const journeyBorder: Record<string, string> = {
  accent:    'border-accent/20 hover:border-accent/40',
  secondary: 'border-secondary/20 hover:border-secondary/40',
  primary:   'border-primary/20 hover:border-primary/40',
};

const colorMap: Record<string, string> = {
  accent:    'border-accent bg-accent/5 hover:bg-accent/10',
  secondary: 'border-secondary bg-secondary/5 hover:bg-secondary/10',
  primary:   'border-primary bg-primary/5 hover:bg-primary/10',
};
const badgeMap: Record<string, string> = {
  accent:    'bg-accent text-white',
  secondary: 'bg-secondary text-white',
  primary:   'bg-primary text-white',
};
const textMap: Record<string, string> = {
  accent:    'text-accent',
  secondary: 'text-secondary',
  primary:   'text-primary',
};
---

<Layout title="Program Özeti">
  <!-- HERO -->
  <div class="rounded-2xl bg-dark text-white p-8 mb-8 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background: radial-gradient(circle at 70% 50%, #C97B5A 0%, transparent 60%)"></div>
    <div class="relative">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <p class="text-secondary text-sm font-medium uppercase tracking-widest mb-2">ECS Eğitim Programı</p>
          <h1 class="text-3xl font-bold mb-2">Veri Bilimi ve Yapay Zeka<br/>Uzmanlığı Programı</h1>
          <p class="text-gray-400 text-sm">Dr. Murat Altun · Google Colab · GitHub Portföyü</p>
        </div>
        <div class="flex gap-4 text-center">
          <div class="bg-white/10 rounded-xl px-5 py-3">
            <div class="text-3xl font-bold text-secondary">90</div>
            <div class="text-xs text-gray-400 mt-1">Toplam Saat</div>
          </div>
          <div class="bg-white/10 rounded-xl px-5 py-3">
            <div class="text-3xl font-bold text-accent">15</div>
            <div class="text-xs text-gray-400 mt-1">Hafta</div>
          </div>
          <div class="bg-white/10 rounded-xl px-5 py-3">
            <div class="text-3xl font-bold text-orange-300">3</div>
            <div class="text-xs text-gray-400 mt-1">Bölüm</div>
          </div>
        </div>
      </div>

      <!-- Değerlendirme -->
      <div class="mt-6 flex flex-wrap gap-3">
        <div class="flex items-center gap-2 bg-white/10 rounded-lg px-3 py-2 text-sm">
          <span class="text-secondary">▪</span> GitHub Portföyü %30
        </div>
        <div class="flex items-center gap-2 bg-white/10 rounded-lg px-3 py-2 text-sm">
          <span class="text-accent">▪</span> Final Sınavı %30
        </div>
        <div class="flex items-center gap-2 bg-white/10 rounded-lg px-3 py-2 text-sm">
          <span class="text-orange-300">▪</span> Capstone Projesi %40
        </div>
      </div>
    </div>
  </div>

  <!-- BÖLÜMLER -->
  {sections.map(section => (
    <div class="mb-10">
      <div class={`flex items-center gap-3 mb-4`}>
        <span class={`inline-block w-1 h-6 rounded-full ${badgeMap[section.color]}`}></span>
        <h2 class={`text-sm font-bold uppercase tracking-widest ${textMap[section.color]}`}>{section.label}</h2>
        <span class="text-xs text-mid bg-border/60 rounded-full px-2 py-0.5">{section.hours} saat</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
        {section.weeks.map(week => (
          <a
            href={`${base}hafta/${week.slug}`}
            class={`group block rounded-xl border-l-4 p-4 transition-all ${colorMap[section.color]} border border-border`}
          >
            <div class="flex items-start justify-between gap-2 mb-3">
              <span class={`text-xs font-bold px-2 py-0.5 rounded-full ${badgeMap[section.color]}`}>HAFTA {week.id}</span>
              <span class="text-xs text-mid">{week.hours} saat</span>
            </div>
            <h3 class="font-semibold text-dark text-sm leading-snug mb-2 group-hover:text-primary transition-colors">{week.title}</h3>
            <p class="text-xs text-mid mb-3">{week.subtitle}</p>
            <div class="flex flex-wrap gap-1">
              {week.libraries.slice(0, 3).map(lib => (
                <span class="text-[10px] bg-white/70 border border-border rounded px-1.5 py-0.5 text-mid font-mono">{lib}</span>
              ))}
              {week.libraries.length > 3 && (
                <span class="text-[10px] text-mid">+{week.libraries.length - 3}</span>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  ))}

  <!-- PLATFORMLAR -->
  <div class="mt-10 mb-8">
    <div class="flex items-center gap-3 mb-4">
      <span class="inline-block w-1 h-6 rounded-full bg-primary"></span>
      <h2 class="text-sm font-bold uppercase tracking-widest text-primary">Platformlar ve Programlar</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {[
        { name: 'Google Colab',  emoji: '🟡', desc: 'Bulutta ücretsiz Python notebook ve GPU erişimi', url: 'https://colab.research.google.com/' },
        { name: 'VS Code',       emoji: '🟦', desc: 'Yerel geliştirme için IDE (PyCharm, Spyder veya tercih ettiğiniz başka bir IDLE de olabilir)', url: 'https://code.visualstudio.com/' },
        { name: 'GitHub',        emoji: '⚫', desc: 'Kod barındırma, versiyon kontrolü, portföy oluşturma', url: 'https://github.com/' },
        { name: 'Kaggle',        emoji: '🔵', desc: 'Veri seti, yarışmalar, hazır notebook örnekleri', url: 'https://www.kaggle.com/' },
        { name: 'Hugging Face',  emoji: '🤗', desc: 'Hazır AI modelleri, Spaces ile model yayınlama', url: 'https://huggingface.co/' },
        { name: 'Google Drive',  emoji: '📁', desc: 'Veri ve materyal paylaşımı, notebook senkronizasyonu', url: 'https://drive.google.com/' },
        { name: 'Streamlit / Gradio', emoji: '🚀', desc: 'Birkaç satırla AI uygulaması arayüzü ve deploy', url: 'https://streamlit.io/' },
      ].map(p => (
        <a href={p.url} target="_blank" rel="noopener" class="group flex items-start gap-3 bg-white rounded-xl border border-border p-4 hover:border-primary/40 hover:shadow-sm transition-all">
          <span class="text-2xl shrink-0">{p.emoji}</span>
          <div>
            <p class="font-semibold text-dark text-sm group-hover:text-primary transition-colors">{p.name}</p>
            <p class="text-xs text-mid mt-1 leading-snug">{p.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- ÖĞRENME YOLCULUĞU: Modüller + Kütüphaneler -->
  <div class="mb-8 rounded-2xl border border-border bg-white p-6">
    <div class="flex items-center gap-3 mb-5">
      <span class="inline-block w-1 h-6 rounded-full bg-secondary"></span>
      <h2 class="text-sm font-bold uppercase tracking-widest text-secondary">Öğrenme Yolculuğu — Modüller ve Kütüphaneler</h2>
    </div>
    <p class="text-sm text-mid mb-5 leading-relaxed">
      15 hafta boyunca <span class="font-semibold text-dark">Python temellerinden başlayıp Generative AI'a</span> kadar uzanan bir yolculuk.
      Her modülde kullanılan kütüphaneler, ilk kullanıldıkları hafta ile birlikte aşağıda:
    </p>

    <div class="space-y-3">
      {[
        { weeks: 'Hafta 1',     module: 'Python Temelleri',                                color: 'accent',    libs: ['Python 3', 'Jupyter / Colab', 'IPython'] },
        { weeks: 'Hafta 2',     module: 'NumPy ve Pandas — EDA',                          color: 'accent',    libs: ['NumPy', 'Pandas', 'OpenPyXL'] },
        { weeks: 'Hafta 3',     module: 'Görselleştirme',                                  color: 'accent',    libs: ['Matplotlib', 'Seaborn', 'Plotly', 'bar_chart_race', 'Sweetviz', 'YData-Profiling', 'PyTrends'] },
        { weeks: 'Hafta 4',     module: 'İstatistik & A/B Testleri',                       color: 'accent',    libs: ['SciPy', 'Statsmodels'] },
        { weeks: 'Hafta 5-6',   module: 'Klasik Makine Öğrenmesi (Regresyon, Sınıflandırma)', color: 'secondary', libs: ['Scikit-learn', 'Joblib'] },
        { weeks: 'Hafta 7',     module: 'Ensemble Modeller',                               color: 'secondary', libs: ['XGBoost', 'LightGBM', 'CatBoost'] },
        { weeks: 'Hafta 8',     module: 'Kümeleme, Zaman Serileri, Öneri',                 color: 'secondary', libs: ['Prophet', 'scikit-surprise'] },
        { weeks: 'Hafta 9',     module: 'MLOps ve Deploy',                                 color: 'secondary', libs: ['Streamlit', 'Gradio', 'Hugging Face Spaces'] },
        { weeks: 'Hafta 10',    module: 'Yapay Sinir Ağları (ANN)',                        color: 'primary',   libs: ['TensorFlow', 'Keras'] },
        { weeks: 'Hafta 11',    module: 'Görüntü İşleme',                                  color: 'primary',   libs: ['OpenCV', 'Pillow', 'scikit-image'] },
        { weeks: 'Hafta 12',    module: 'CNN & Transfer Learning',                         color: 'primary',   libs: ['TensorFlow', 'Keras Applications', 'Albumentations'] },
        { weeks: 'Hafta 13',    module: 'NLP & Hugging Face',                              color: 'primary',   libs: ['Transformers', 'NLTK', 'spaCy', 'Datasets'] },
        { weeks: 'Hafta 14',    module: 'Generative AI & LLM',                             color: 'primary',   libs: ['Google Gemini API', 'LangChain', 'ChromaDB', 'OpenAI SDK'] },
        { weeks: 'Hafta 15',    module: 'AI Etik & Capstone',                              color: 'primary',   libs: ['Fairness Indicators', 'Projeye özel'] },
      ].map(row => (
        <div class={`flex items-start gap-4 rounded-xl border bg-warmBg/40 p-3 transition-colors ${journeyBorder[row.color]}`}>
          <div class="shrink-0 flex flex-col items-center min-w-[70px]">
            <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded ${journeyBadge[row.color]}`}>{row.weeks}</span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-semibold text-dark text-sm mb-1.5">{row.module}</p>
            <div class="flex flex-wrap gap-1">
              {row.libs.map(lib => (
                <code class="text-[11px] bg-dark text-green-300 rounded px-2 py-0.5 font-mono">{lib}</code>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-5 pt-5 border-t border-border flex flex-wrap gap-3 text-xs text-mid">
      <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-accent inline-block"></span> Veri Bilimi Temelleri (24 saat)</span>
      <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-secondary inline-block"></span> Makine Öğrenmesi Uzmanlığı (30 saat)</span>
      <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-primary inline-block"></span> Yapay Zeka Mühendisliği (36 saat)</span>
    </div>
  </div>

  <!-- KATILIM KOŞULLARI -->
  <div class="mb-8 rounded-2xl bg-warmBg border border-border p-6">
    <div class="flex items-center gap-3 mb-4">
      <span class="inline-block w-1 h-6 rounded-full bg-accent"></span>
      <h2 class="text-sm font-bold uppercase tracking-widest text-accent">Katılım Koşulları</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {[
        { icon: '💻', title: 'Bilgisayar ve İnternet', desc: 'Windows / Mac / Linux fark etmez. Bulut tabanlı (Colab) çalışılır, donanım gerekmez. İstikrarlı internet bağlantısı yeterlidir.' },
        { icon: '🐍', title: 'Programlama Ön Şartı Yok', desc: 'Python sıfırdan başlar. Daha önce kod yazmamış olmak sorun değildir. Mantık ve sabır yeter.' },
        { icon: '🌐', title: 'Temel İngilizce Okuma', desc: 'Dokümantasyon ve hata mesajları İngilizcedir. Çeviri araçlarıyla rahat çalışılabilir.' },
        { icon: '⏱️', title: 'Haftada 6-8 Saat', desc: 'Canlı ders + ödev + pratik için ayrılması önerilen süre. Düzenli pratik başarının anahtarıdır.' },
        { icon: '🔐', title: 'Hesaplar (Ücretsiz)', desc: 'Google, GitHub, Kaggle ve Hugging Face hesapları (hepsi ücretsiz). İlk hafta birlikte açılır.' },
        { icon: '🚀', title: 'Öğrenme Tutkusu', desc: 'Problem çözmeye açık, projelerle öğrenmeyi seven, sorular soran katılımcı profili idealdir.' },
      ].map(req => (
        <div class="flex items-start gap-3 bg-white rounded-xl border border-border p-4">
          <span class="text-2xl shrink-0">{req.icon}</span>
          <div>
            <p class="font-semibold text-dark text-sm mb-1">{req.title}</p>
            <p class="text-xs text-mid leading-relaxed">{req.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- KAYIT CTA -->
  <div class="mb-10 rounded-2xl bg-dark text-white p-8 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-20" style="background: radial-gradient(circle at 30% 50%, #C97B5A 0%, transparent 60%)"></div>
    <div class="relative">
      <p class="text-secondary text-xs font-semibold uppercase tracking-widest mb-2">Kayıt</p>
      <h2 class="text-2xl font-bold mb-3">90 Saatlik Programa Katılın</h2>
      <p class="text-gray-300 text-sm max-w-xl mx-auto mb-5">
        Dr. Murat ALTUN ile canlı, etkileşimli Veri Bilimi ve Yapay Zeka Uzmanlığı eğitimi.
        Detaylı bilgi ve kayıt için WhatsApp üzerinden iletişime geçin.
      </p>
      <a
        href="https://wa.me/905392578206?text=Dr.%20Murat%20ALTUN%20referans%20Nisan-2026%20kodu%20ile%2090%20saatlik%20canl%C4%B1%20Veri%20Bilimi%20ve%20Yapay%20Zeka%20Uzmanl%C4%B1%C4%9F%C4%B1%20kursuna%20kaydolmak%20istiyorum."
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 bg-[#25D366] text-white font-semibold px-6 py-3 rounded-xl hover:bg-[#1ebe57] transition-colors shadow-lg"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        WhatsApp'tan Kayıt Ol
      </a>
      <p class="text-gray-400 text-[10px] mt-3">📞 +90 539 257 82 06 · Referans Kodu: <span class="text-secondary font-semibold">Nisan-2026</span></p>
    </div>
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { weeks, getWeekBySlug } from '../../data/curriculum';

export function getStaticPaths() {
  return weeks.map(w => ({ params: { id: w.slug } }));
}

const { id } = Astro.params;
const week = getWeekBySlug(id!);
if (!week) return Astro.redirect('/');

const base = import.meta.env.BASE_URL;
const pdfFile = week.pptxFile.replace('.pptx', '.pdf');
const driveId = week.pptxDriveId;
const pdfUrl = driveId ? `https://drive.google.com/file/d/${driveId}/preview` : `${base}sunumlar/${pdfFile}#toolbar=0&navpanes=0`;

const prevWeek = weeks.find(w => w.id === week.id - 1);
const nextWeek = weeks.find(w => w.id === week.id + 1);

const sectionColorClass: Record<string, string> = {
  'VERİ BİLİMİ TEMELLERİ':       'bg-accent',
  'MAKİNE ÖĞRENMESİ UZMANLIĞI':  'bg-secondary',
  'YAPAY ZEKA MÜHENDİSLİĞİ':     'bg-primary',
};
const badgeBg = sectionColorClass[week.section] ?? 'bg-mid';

const PREVIEW = 2;
const REGISTER_URL = 'mailto:emurataltun@gmail.com?subject=ECS%20Veri%20Bilimi%20%26%20YZ%20Kay%C4%B1t%20Talebi';

const topicsPreview = week.topics.slice(0, PREVIEW);
const topicsLocked  = week.topics.slice(PREVIEW);
const assignPreview = week.assignments.slice(0, PREVIEW);
const assignLocked  = week.assignments.slice(PREVIEW);
const nbPreview     = week.notebooks.slice(0, PREVIEW);
const nbLocked      = week.notebooks.slice(PREVIEW);
const resPreview    = week.resources.slice(0, PREVIEW);
const resLocked     = week.resources.slice(PREVIEW);
---

<Layout
  title={`Hafta ${week.id}: ${week.title}`}
  description={`${week.section} — ${week.title}. ${week.topics.slice(0,3).join(', ')} ve daha fazlası. Dr. Murat Altun, ECS 90 saatlik program.`}
  activeWeekId={week.id}
  canonical={`https://drmurataltun.github.io/VB-YZ-90/hafta/${week.slug}/`}
>

  <!-- BREADCRUMB -->
  <div class="flex items-center gap-2 text-xs text-mid mb-4">
    <a href={base} class="hover:text-primary transition-colors">Program</a>
    <span>›</span>
    <span class={`px-2 py-0.5 rounded-full text-white text-[10px] font-bold ${badgeBg}`}>{week.section}</span>
    <span>›</span>
    <span class="text-dark font-medium">Hafta {week.id}</span>
  </div>

  <!-- HEADER -->
  <div class="mb-6">
    <div class="flex items-start justify-between flex-wrap gap-3">
      <div>
        <span class={`inline-block text-[10px] font-bold uppercase tracking-wider text-white px-2 py-0.5 rounded ${badgeBg} mb-2`}>
          HAFTA {week.id} · {week.hours} SAAT
        </span>
        <h1 class="text-2xl font-bold text-dark leading-snug">{week.title}</h1>
        <p class="text-mid text-sm mt-1">{week.subtitle}</p>
      </div>
      <!-- Nav ok -->
      <div class="flex gap-2">
        {prevWeek && (
          <a href={`${base}hafta/${prevWeek.slug}`} class="flex items-center gap-1 text-xs text-mid hover:text-primary border border-border rounded-lg px-3 py-2 bg-white transition-colors">
            ← Hafta {prevWeek.id}
          </a>
        )}
        {nextWeek && (
          <a href={`${base}hafta/${nextWeek.slug}`} class="flex items-center gap-1 text-xs text-white bg-primary hover:bg-primary/90 rounded-lg px-3 py-2 transition-colors">
            Hafta {nextWeek.id} →
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- SUNUM (iframe) -->
  <div class="rounded-2xl overflow-hidden border border-border shadow-md mb-6 bg-dark">
    <div class="flex items-center gap-2 px-4 py-2 bg-dark border-b border-white/10">
      <div class="flex gap-1.5">
        <span class="w-3 h-3 rounded-full bg-red-500/70"></span>
        <span class="w-3 h-3 rounded-full bg-yellow-500/70"></span>
        <span class="w-3 h-3 rounded-full bg-green-500/70"></span>
      </div>
      <span class="text-xs text-gray-400 ml-2">📊 {week.pptxFile}</span>
    </div>
    <iframe
      src={pdfUrl}
      width="100%"
      height="560"
      frameborder="0"
      class="w-full block bg-white"
      loading="lazy"
      title={`Hafta ${week.id} Sunumu`}
    />
  </div>

  <!-- SEKMELER: Konular / Ödevler / Notebook / Kaynaklar -->
  <div x-data="{ tab: 'konular' }" class="mb-6">
    <!-- Tab buttons -->
    <div class="flex gap-1 border-b border-border mb-4" id="tabs">
      {[
        { key: 'konular', label: '📋 Konular',   count: week.topics.length },
        { key: 'odevler', label: '📝 Ödevler',   count: week.assignments.length },
        { key: 'notebook', label: '💻 Notebook\'lar', count: week.notebooks.length },
        { key: 'kaynaklar', label: '📚 Kaynaklar', count: week.resources.length },
      ].map(tab => (
        <button
          data-tab={tab.key}
          onclick="switchTab(this)"
          class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-mid hover:text-primary transition-colors -mb-px"
        >
          {tab.label}
          <span class="ml-1 text-[10px] bg-border rounded-full px-1.5 py-0.5">{tab.count}</span>
        </button>
      ))}
    </div>

    <!-- Konular -->
    <div data-panel="konular" class="tab-panel">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        {topicsPreview.map((topic, i) => (
          <div class="flex items-start gap-3 bg-white rounded-lg border border-border p-3">
            <span class="shrink-0 w-6 h-6 rounded-full bg-accent/10 text-accent text-xs font-bold flex items-center justify-center">{i + 1}</span>
            <span class="text-sm text-dark leading-snug">{topic}</span>
          </div>
        ))}
        {topicsLocked.map((topic, i) => (
          <div class="relative flex items-start gap-3 bg-white rounded-lg border border-border p-3 select-none overflow-hidden">
            <span class="shrink-0 w-6 h-6 rounded-full bg-mid/10 text-mid text-xs font-bold flex items-center justify-center">{i + PREVIEW + 1}</span>
            <span class="text-sm text-dark leading-snug blur-sm">{topic}</span>
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-mid text-lg">🔒</span>
          </div>
        ))}
      </div>
      {topicsLocked.length > 0 && (
        <div class="mt-4 rounded-xl border border-dashed border-secondary/40 bg-secondary/5 p-5 flex items-center justify-between flex-wrap gap-3">
          <div>
            <p class="text-sm font-semibold text-dark">🔒 {topicsLocked.length} konu daha kilitli</p>
            <p class="text-xs text-mid mt-1">Tüm içeriğe erişmek için ECS programına kayıt olun.</p>
          </div>
          <a href={REGISTER_URL} class="shrink-0 inline-flex items-center gap-2 bg-secondary text-white text-xs font-semibold px-4 py-2 rounded-lg hover:bg-secondary/90 transition-colors">
            Kayıt Ol →
          </a>
        </div>
      )}
      {week.libraries.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2 items-center">
          <span class="text-xs text-mid font-medium">Kütüphaneler:</span>
          {week.libraries.map(lib => (
            <code class="text-xs bg-dark text-green-300 rounded px-2 py-0.5 font-mono">{lib}</code>
          ))}
        </div>
      )}
    </div>

    <!-- Ödevler -->
    <div data-panel="odevler" class="tab-panel hidden">
      <div class="space-y-3">
        {assignPreview.map((a, i) => (
          <div class="flex items-start gap-3 bg-warmBg rounded-lg border border-border p-4">
            <span class="shrink-0 w-7 h-7 rounded-full bg-secondary text-white text-xs font-bold flex items-center justify-center">{i + 1}</span>
            <p class="text-sm text-dark leading-relaxed">{a}</p>
          </div>
        ))}
        {assignLocked.map((a, i) => (
          <div class="relative flex items-start gap-3 bg-warmBg rounded-lg border border-border p-4 select-none overflow-hidden">
            <span class="shrink-0 w-7 h-7 rounded-full bg-mid/60 text-white text-xs font-bold flex items-center justify-center">{i + PREVIEW + 1}</span>
            <p class="text-sm text-dark leading-relaxed blur-sm flex-1">{a}</p>
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-mid text-lg">🔒</span>
          </div>
        ))}
      </div>
      {assignLocked.length > 0 && (
        <div class="mt-4 rounded-xl border border-dashed border-secondary/40 bg-secondary/5 p-5 flex items-center justify-between flex-wrap gap-3">
          <div>
            <p class="text-sm font-semibold text-dark">🔒 {assignLocked.length} ödev daha kilitli</p>
            <p class="text-xs text-mid mt-1">Tüm ödevlere ve çözümlere erişmek için ECS programına kayıt olun.</p>
          </div>
          <a href={REGISTER_URL} class="shrink-0 inline-flex items-center gap-2 bg-secondary text-white text-xs font-semibold px-4 py-2 rounded-lg hover:bg-secondary/90 transition-colors">
            Kayıt Ol →
          </a>
        </div>
      )}
    </div>

    <!-- Notebook'lar -->
    <div data-panel="notebook" class="tab-panel hidden">
      <div class="space-y-3">
        {nbPreview.map((nb, i) => (
          <div class="flex items-start gap-4 bg-dark text-white rounded-xl p-4">
            <span class="shrink-0 w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center text-green-400 font-mono text-sm font-bold">{i + 1}</span>
            <div class="flex-1">
              <code class="text-green-300 text-sm font-mono block mb-1">{nb.name}</code>
              <p class="text-gray-400 text-xs mb-2">{nb.desc}</p>
              {nb.url && (
                <div class="flex flex-wrap gap-2">
                  <a href={nb.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-white/10 text-xs text-gray-300 hover:text-white hover:bg-white/20 transition-colors">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                    Drive'da Aç
                  </a>
                  <a href={nb.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-yellow-500/20 text-xs text-yellow-300 hover:text-yellow-100 hover:bg-yellow-500/30 transition-colors">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M4.54 9.46L2.19 7.1l2.35-2.35L6.9 7.1 4.54 9.46zm6.96 10.6l-2.35-2.35 2.35-2.35 2.35 2.35-2.35 2.35zM19.46 9.46L17.1 7.1l2.36-2.35 2.35 2.35-2.35 2.36zM7.1 17.1l-2.35-2.35 2.35-2.36 2.36 2.36L7.1 17.1zM11.5 2l-2.35 2.35L11.5 6.7l2.35-2.35L11.5 2zM4.54 14.75l-2.35-2.35 2.35-2.36 2.36 2.36-2.36 2.35zM16.9 17.1l-2.36-2.35 2.36-2.36 2.35 2.36-2.35 2.35zM11.5 12.65l-2.35-2.36 2.35-2.35 2.35 2.35-2.35 2.36zM14.75 19.46l-2.35-2.35 2.35-2.35 2.36 2.35-2.36 2.35zM19.46 14.75l-2.36-2.35 2.36-2.36 2.35 2.36-2.35 2.35z"/></svg>
                    Colab'da Aç
                  </a>
                </div>
              )}
            </div>
          </div>
        ))}
        {nbLocked.map((nb, i) => (
          <div class="relative flex items-start gap-4 bg-dark text-white rounded-xl p-4 overflow-hidden select-none pointer-events-none">
            <span class="shrink-0 w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center text-mid font-mono text-sm font-bold">{i + PREVIEW + 1}</span>
            <div class="flex-1 blur-sm">
              <code class="text-green-300 text-sm font-mono block mb-1">{nb.name}</code>
              <p class="text-gray-400 text-xs mb-2">{nb.desc}</p>
              <div class="flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-white/10 text-xs text-gray-400">Drive'da Aç</span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-yellow-500/20 text-xs text-yellow-400">Colab'da Aç</span>
              </div>
            </div>
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-2xl">🔒</span>
          </div>
        ))}
      </div>
      {nbLocked.length > 0 && (
        <div class="mt-4 rounded-xl border border-dashed border-secondary/40 bg-secondary/5 p-5 flex items-center justify-between flex-wrap gap-3">
          <div>
            <p class="text-sm font-semibold text-dark">🔒 {nbLocked.length} notebook daha kilitli</p>
            <p class="text-xs text-mid mt-1">Tüm Colab notebook'larına erişmek için ECS programına kayıt olun.</p>
          </div>
          <a href={REGISTER_URL} class="shrink-0 inline-flex items-center gap-2 bg-secondary text-white text-xs font-semibold px-4 py-2 rounded-lg hover:bg-secondary/90 transition-colors">
            Kayıt Ol →
          </a>
        </div>
      )}
      {week.datasets.length > 0 && (
        <div class="mt-4">
          <p class="text-xs font-medium text-mid mb-2">Veri Setleri:</p>
          <div class="flex flex-wrap gap-2">
            {week.datasets.map(ds => (
              <span class="text-xs bg-accent/10 text-accent border border-accent/20 rounded-full px-3 py-1">{ds}</span>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Kaynaklar -->
    <div data-panel="kaynaklar" class="tab-panel hidden">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {resPreview.map(r => (
          <a
            href={r.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 bg-white border border-border rounded-xl p-4 hover:border-accent hover:shadow-sm transition-all group"
          >
            <span class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center text-accent text-base">🔗</span>
            <div>
              <p class="text-sm font-medium text-dark group-hover:text-accent transition-colors">{r.label}</p>
              <p class="text-[10px] text-mid truncate max-w-[200px]">{r.url}</p>
            </div>
          </a>
        ))}
        {resLocked.map(r => (
          <div class="relative flex items-center gap-3 bg-white border border-border rounded-xl p-4 overflow-hidden select-none pointer-events-none">
            <span class="w-8 h-8 rounded-lg bg-mid/10 flex items-center justify-center text-mid text-base">🔒</span>
            <div class="blur-sm">
              <p class="text-sm font-medium text-dark">{r.label}</p>
              <p class="text-[10px] text-mid truncate max-w-[200px]">{r.url}</p>
            </div>
          </div>
        ))}
      </div>
      {resLocked.length > 0 && (
        <div class="mt-4 rounded-xl border border-dashed border-secondary/40 bg-secondary/5 p-5 flex items-center justify-between flex-wrap gap-3">
          <div>
            <p class="text-sm font-semibold text-dark">🔒 {resLocked.length} kaynak daha kilitli</p>
            <p class="text-xs text-mid mt-1">Tüm öğrenme kaynaklarına erişmek için ECS programına kayıt olun.</p>
          </div>
          <a href={REGISTER_URL} class="shrink-0 inline-flex items-center gap-2 bg-secondary text-white text-xs font-semibold px-4 py-2 rounded-lg hover:bg-secondary/90 transition-colors">
            Kayıt Ol →
          </a>
        </div>
      )}
    </div>
  </div>

</Layout>

<script is:inline>
function switchTab(btn) {
  var key = btn.getAttribute('data-tab');
  // Update buttons
  document.querySelectorAll('.tab-btn').forEach(function(b) {
    b.classList.remove('border-primary', 'text-primary');
    b.classList.add('border-transparent', 'text-mid');
  });
  btn.classList.add('border-primary', 'text-primary');
  btn.classList.remove('border-transparent', 'text-mid');
  // Update panels
  document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.add('hidden'); });
  var panel = document.querySelector('[data-panel="' + key + '"]');
  if (panel) panel.classList.remove('hidden');
}
// Activate first tab on load
document.addEventListener('DOMContentLoaded', function() {
  var first = document.querySelector('.tab-btn');
  if (first) switchTab(first);
});
</script>
